import random
from collections import Counter

# English letter frequency order
ENGLISH_FREQ = "ETAOINSHRDLCUMWFGYPBVKJXQZ"

# Common English words used for scoring
COMMON_WORDS = [
    "THE", "BE", "TO", "OF", "AND", "A", "IN", "THAT",
    "HAVE", "I", "IT", "FOR", "NOT", "ON", "WITH", "HE",
    "AS", "YOU", "DO", "AT", "THIS", "BUT", "HIS", "BY",
    "FROM", "THEY", "WE", "SAY", "HER", "SHE", "OR",
    "AN", "WILL", "MY", "ONE", "ALL", "WOULD", "THERE"
]

# Common English letter combinations
COMMON_BIGRAMS = [
    "TH", "HE", "IN", "ER", "AN", "RE", "ON", "AT",
    "EN", "ND", "TI", "ES", "OR", "TE", "OF", "ED",
    "IS", "IT", "AL", "AR", "ST", "TO", "NT", "NG"
]


def get_frequency_key(ciphertext):
    letters = [c for c in ciphertext.upper() if c.isalpha()]

    count = Counter(letters)

    # Cipher letters ordered by frequency
    cipher_freq = [x[0] for x in count.most_common()]

    # Add unused letters
    for ch in "ABCDEFGHIJKLMNOPQRSTUVWXYZ":
        if ch not in cipher_freq:
            cipher_freq.append(ch)

    # Create initial substitution mapping
    key = {}

    for i in range(26):
        key[cipher_freq[i]] = ENGLISH_FREQ[i]

    return key


def decrypt(ciphertext, key):
    plaintext = ""

    for ch in ciphertext.upper():
        if ch.isalpha():
            plaintext += key[ch]
        else:
            plaintext += ch

    return plaintext


def score_text(text):
    score = 0
    words = text.split()

    # Score common words
    for word in words:
        clean_word = ''.join(c for c in word if c.isalpha())

        if clean_word in COMMON_WORDS:
            score += 10

    # Score common bigrams
    for bigram in COMMON_BIGRAMS:
        score += text.count(bigram) * 2

    # Reward vowels
    vowel_count = sum(1 for c in text if c in "AEIOU")
    score += vowel_count * 0.1

    return score


def random_swap_key(key):
    new_key = key.copy()

    letters = list(new_key.keys())

    a, b = random.sample(letters, 2)

    # Swap plaintext mappings
    new_key[a], new_key[b] = new_key[b], new_key[a]

    return new_key


def frequency_attack(ciphertext, top_n=10, attempts=10000):

    initial_key = get_frequency_key(ciphertext)

    best_candidates = []

    current_key = initial_key
    current_plaintext = decrypt(ciphertext, current_key)
    current_score = score_text(current_plaintext)

    for _ in range(attempts):

        new_key = random_swap_key(current_key)

        plaintext = decrypt(ciphertext, new_key)
        new_score = score_text(plaintext)

        # Accept better solution
        if new_score > current_score:
            current_key = new_key
            current_score = new_score

        best_candidates.append(
            (new_score, plaintext)
        )

    # Sort candidates by score
    best_candidates.sort(
        key=lambda x: x[0],
        reverse=True
    )

    # Remove duplicate plaintexts
    unique_results = []
    seen = set()

    for score, text in best_candidates:

        if text not in seen:
            seen.add(text)
            unique_results.append(
                (score, text)
            )

        if len(unique_results) == top_n:
            break

    return unique_results


# ---------------- MAIN PROGRAM ----------------

ciphertext = input(
    "Enter monoalphabetic substitution ciphertext:\n"
)

top_n = int(
    input("How many possible plaintexts do you want? ")
)

results = frequency_attack(
    ciphertext,
    top_n,
    attempts=20000
)

print("\nTop Possible Plaintexts")
print("-" * 50)

for i, (score, plaintext) in enumerate(results, 1):

    print(f"\nCandidate {i}")
    print("Score:", score)
    print("Plaintext:", plaintext)
