# Monoalphabetic Substitution Cipher
# Letter Frequency Attack

import random
from collections import Counter

ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"

# English letter frequency order
ENGLISH_FREQ = "ETAOINSHRDLCUMWFGYPBVKJXQZ"

# Common English words
COMMON_WORDS = {
    "THE": 10, "AND": 8, "THAT": 7, "THIS": 7,
    "WITH": 6, "HAVE": 6, "FROM": 5, "THEY": 5,
    "BE": 5, "TO": 5, "OF": 5, "IN": 5,
    "IS": 5, "IT": 5, "FOR": 5, "ON": 5,
    "AS": 5, "AT": 5, "YOU": 5, "WE": 5,
    "HE": 5, "SHE": 5, "WAS": 5, "ARE": 5
}

# Common English letter pairs
COMMON_BIGRAMS = [
    "TH", "HE", "IN", "ER", "AN", "RE",
    "ON", "AT", "EN", "ND", "TI", "ES",
    "OR", "TE", "OF", "ED", "IS", "IT",
    "AL", "AR", "ST", "TO", "NT", "NG"
]


def decrypt(ciphertext, key):
    """Decrypt ciphertext using substitution key."""
    plaintext = ""

    for ch in ciphertext.upper():
        if ch in ALPHABET:
            plaintext += key[ch]
        else:
            plaintext += ch

    return plaintext


def initial_key(ciphertext):
    """Create an initial key using frequency analysis."""

    letters = [
        ch for ch in ciphertext.upper()
        if ch in ALPHABET
    ]

    frequency = Counter(letters)

    # Cipher letters sorted by frequency
    cipher_order = [
        item[0] for item in frequency.most_common()
    ]

    # Add letters that do not occur
    for ch in ALPHABET:
        if ch not in cipher_order:
            cipher_order.append(ch)

    key = {}

    for i in range(26):
        key[cipher_order[i]] = ENGLISH_FREQ[i]

    return key


def score_text(text):
    """Calculate how likely the text is to be English."""

    score = 0

    # Score common words
    words = text.split()

    for word in words:
        word = ''.join(
            ch for ch in word if ch in ALPHABET
        )

        if word in COMMON_WORDS:
            score += COMMON_WORDS[word]

    # Score common bigrams
    for bigram in COMMON_BIGRAMS:
        score += text.count(bigram) * 2

    # Penalize unusual letter combinations
    score -= text.count("Q") - text.count("QU")

    return score


def swap_key(key):
    """Randomly swap two plaintext mappings."""

    new_key = key.copy()

    letters = list(new_key.keys())

    a, b = random.sample(letters, 2)

    new_key[a], new_key[b] = new_key[b], new_key[a]

    return new_key


def frequency_attack(ciphertext, top_n, iterations=30000):

    key = initial_key(ciphertext)

    plaintext = decrypt(ciphertext, key)

    best_score = score_text(plaintext)

    candidates = []

    for i in range(iterations):

        new_key = swap_key(key)

        new_plaintext = decrypt(ciphertext, new_key)

        new_score = score_text(new_plaintext)

        # Keep a better solution
        if new_score >= best_score:
            key = new_key
            best_score = new_score
            plaintext = new_plaintext

        candidates.append(
            (best_score, plaintext)
        )

    # Sort according to score
    candidates.sort(
        key=lambda x: x[0],
        reverse=True
    )

    # Remove duplicate plaintexts
    results = []
    seen = set()

    for score, text in candidates:

        if text not in seen:
            seen.add(text)
            results.append((score, text))

        if len(results) >= top_n:
            break

    return results


# ---------------- MAIN PROGRAM ----------------

print("MONOALPHABETIC SUBSTITUTION CIPHER")
print("LETTER FREQUENCY ATTACK")
print("------------------------------------")

ciphertext = input(
    "Enter ciphertext:\n"
)

top_n = int(
    input("\nHow many possible plaintexts do you want? ")
)

if top_n < 1:
    top_n = 1

if top_n > 10:
    top_n = 10

results = frequency_attack(
    ciphertext,
    top_n
)

print("\nTOP", top_n, "POSSIBLE PLAINTEXTS")
print("=" * 50)

for i, (score, plaintext) in enumerate(results, 1):

    print("\nCandidate", i)
    print("Score    :", score)
    print("Plaintext:", plaintext)
